# PosFlow production environment variables.
# Copy this to .env (git-ignored) for local docker-compose use, or set
# these directly in your host/secrets manager (Azure App Service
# config, AWS Secrets Manager, Kubernetes Secrets, etc.) - NEVER commit
# real values. ASP.NET Core reads "__" as the config-section separator
# (e.g. ConnectionStrings__DefaultConnection maps to
# appsettings.json's ConnectionStrings:DefaultConnection).

ASPNETCORE_ENVIRONMENT=Production

# --- Database ---------------------------------------------------------
ConnectionStrings__DefaultConnection=Server=YOUR_SQL_HOST;Database=PosFlowDb;User Id=posflow_app;Password=CHANGE_ME;TrustServerCertificate=True

# --- JWT ---------------------------------------------------------------
# Generate a real random 32+ char secret, e.g.: openssl rand -base64 48
Jwt__Key=CHANGE_ME_GENERATE_A_REAL_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=PosFlow.Api
Jwt__Audience=PosFlow.Web
Jwt__ExpirationMinutes=480
Jwt__RefreshTokenExpirationDays=30

# --- CORS ----------------------------------------------------------------
Cors__AllowedOrigins__0=https://your-real-frontend-domain.example.com

# --- App -------------------------------------------------------------
App__FrontendBaseUrl=https://your-real-frontend-domain.example.com
# Leave both false in steady-state production. See deploy/README.md.
App__AutoMigrateOnStartup=false
App__BootstrapAdminIfEmpty=false

# --- SMTP (forgot-password emails) ------------------------------------
Smtp__Host=smtp.sendgrid.net
Smtp__Port=587
Smtp__UseSsl=true
Smtp__Username=apikey
Smtp__Password=CHANGE_ME
Smtp__FromAddress=noreply@your-real-domain.example.com
Smtp__FromName=PosFlow

# --- SQL Server container (docker-compose only) -----------------------
MSSQL_SA_PASSWORD=CHANGE_ME_Strong_Password123!

# --- Real secrets manager (optional, Azure Key Vault) -------------------
# Leave unset to keep using plain environment variables (still fine).
# Set this to pull secrets from Key Vault instead - see Program.cs.
# Needs a managed identity (in Azure) or `az login` (locally) with Get
# permission on the vault's secrets; Key Vault secret names use "--"
# where config uses ":" (e.g. "Jwt--Key" -> Jwt:Key).
KeyVault__Uri=
