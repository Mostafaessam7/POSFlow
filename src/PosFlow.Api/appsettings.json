{
  "_comment": "This file ships with NO real secrets on purpose (fails closed). Every production value below (Jwt:Key, ConnectionStrings, Smtp:*) must come from environment variables or a secrets manager - see /.env.example and ENTERPRISE-READINESS.md. Do not put real credentials in this file.",

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PosFlowDb;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Jwt": {
    "Key": "PosFlow-Development-Key-Change-Me-2026-Minimum-32-Characters",
    "Issuer": "PosFlow.Api",
    "Audience": "PosFlow.Web",
    "ExpirationMinutes": 480,
    "RefreshTokenExpirationDays": 30
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "App": {
    "FrontendBaseUrl": "https://CHANGE-ME.example.com",
    "AutoMigrateOnStartup": false,
    "BootstrapAdminIfEmpty": false
  },

  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@CHANGE-ME.example.com",
    "FromName": "PosFlow"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
